APP_ENV=development
DATABASE_URL=postgresql+psycopg://autoseguro:autoseguro@localhost:5432/autoseguro
QUOTE_SERVICE_URL=http://localhost:8000
QUOTE_TIMEOUT_SECONDS=3
QUOTE_MAX_ATTEMPTS=3
QUOTE_BACKOFF_SECONDS=0.25
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AUTO_CREATE_SCHEMA=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
ENABLE_HSTS=false
RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT=120
SESSION_CREATE_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGES_PER_SESSION=100
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=1800
COORDINATION_BACKEND=local
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=autoseguro
IDEMPOTENCY_TTL_SECONDS=86400
SESSION_LOCK_TTL_SECONDS=30
SESSION_LOCK_WAIT_SECONDS=12
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_OPEN_SECONDS=30
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
TELEMETRY_SERVICE_NAME=autoseguro-agent
POLICY_MODE=shadow
CEDAR_POLICY_PATH=policies/autoseguro.cedar
CEDAR_SCHEMA_PATH=policies/autoseguro.cedarschema
POLICY_ENFORCE_ACTIONS=CallQuote
